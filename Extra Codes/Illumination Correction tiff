def Illumination_Correction(folder_path, factor, display=True, save=True):
    """
    Perform illumination correction on TIFF images in a folder.

    Parameters
    ----------
    folder_path : str
        Path to the folder containing TIFF images.
    factor : float
        Smoothness factor for flatfield correction.
    display : bool, optional
        Whether to display the original and corrected images. Default is True.
    save : bool, optional
        Whether to save the corrected images. Default is True.
    """
    import numpy as np
    from basicpy import BaSiC
    from matplotlib import pyplot as plt
    import os
    from tifffile import imsave

    # Iterate over each image file in the folder
    for filename in os.listdir(folder_path):
        if filename.endswith(".tiff"):
            print(f"Processing file: {filename}")
            
            # Specify the path to the TIFF file
            tiff_path = os.path.join(folder_path, filename)

            # Read the TIFF file
            images = plt.imread(tiff_path)

            # Change images to a 3D array with shape (1, height, width) from 2D
            images = np.expand_dims(images, axis=0)
            basic = BaSiC(get_darkfield=True, smoothness_flatfield=factor, smoothness_darkfield=1)
            basic.fit(images)

            # Apply the correction
            images_transformed = basic.transform(images)

            # Display the original and corrected images if display is enabled
            if display:
                fig, axes = plt.subplots(1, 2, figsize=(12, 6))
                axes[0].imshow(images[0], cmap='gray')
                axes[0].set_title(f"Original - {filename}", fontsize=7)
                axes[0].axis('off')  # Remove axes
                axes[1].imshow(images_transformed[0], cmap='gray')
                axes[1].set_title(f"Corrected - {filename}", fontsize=7)
                axes[1].axis('off')  # Remove axes
                plt.show()

            # Save the corrected image to the original file if save is enabled
            if save:
                imsave(tiff_path, images_transformed[0].astype(np.float32))
                print(f"Saved corrected image to: {tiff_path}")

